{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yamp",
  "version": "0.1.0",
  "identifier": "com.salad.yamp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "yamp",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/music/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Julius-IX/yamp/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzODRFQTFGRDE0MUFCOUUKUldTZXEwSFJIK3FFa3hPcG1mbm0rVUNZdDJRQmI5N3lyK2JENTNSTko3eS8xWHZFZERRVURJVlgK"
    },
    "deep-link": {
      "mobile": [
        {
          "scheme": ["com.salad.yamp"],
          "appLink": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
