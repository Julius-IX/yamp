  "query": "SELECT t.id AS \"id!\", t.title AS \"title!\", t.artist AS \"artist!\", t.album, t.duration_secs, t.thumbnail, t.release_year AS \"release_year: u32\" FROM tracks t\n           WHERE t.title LIKE ?1 ESCAPE '\\' OR t.artist LIKE ?1 ESCAPE '\\' OR t.album LIKE ?1 ESCAPE '\\'\n           ORDER BY (t.title LIKE ?1 ESCAPE '\\') DESC, t.title COLLATE NOCASE\n           LIMIT ?2",
