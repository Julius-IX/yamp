  "query": "SELECT\n             t.id AS \"id!\",\n             t.title AS \"title!\",\n             t.artist AS \"artist!\",\n             t.album,\n             t.duration_secs,\n             t.thumbnail,\n             t.release_year AS \"release_year: u32\"\n           FROM downloads d JOIN tracks t ON t.id = d.track_id\n           ORDER BY d.downloaded_ms DESC, d.track_id LIMIT ? OFFSET ?",
